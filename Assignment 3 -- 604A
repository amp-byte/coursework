/*Design SQL queries to do the following:*/

/*List Names of all countries in the Continent of North America*/
SELECT Name FROM world.country
	WHERE continent = 'North America';
    
/*List Name, Continent, and Region for all countries whose Surface Area is more than or equal to 1,000,000*/
SELECT Name, Continent, Region FROM world.country
	WHERE SurfaceArea >= 1000000;
    
/*List Names of all countries whose GovernmentForm is Constitutional Monarchy*/
SELECT Name FROM world.country
	WHERE GovernmentForm = 'Constitutional Monarchy';

/*List country Names and their Capital (name) for all countries in the Continent of South America*/
SELECT Name, Capital FROM world.country
	WHERE Continent = 'South America';

/*List all fields for countries whose Population is more than 500,000,000*/
SELECT * FROM world.country
	WHERE Population > 500000000;

/*List all fields for countries whose GovernmentForm is Federal Republic*/
SELECT * FROM world.country
	WHERE GovernmentForm = 'Federal Republic';

/*List sum of Population of each Continent (grouped by Continent)*/
SELECT Continent, SUM(Population) AS Total_Population 
	FROM world.country
		GROUP BY Continent;

/*List Names of countries whose Language is German*/
SELECT c.Name FROM world.country c
	LEFT JOIN world.countrylanguage cl ON c.Code = cl.CountryCode
		WHERE cl.Language = 'German';

/*List all fields for countries whose Population is more than or equal to 200,000,000 and whose Surface Area is more than or equal to 500,000*/
SELECT * FROM world.country
	WHERE Population >= 200000000 AND SurfaceArea >= 500000;
    
/*List Names of countries whose Independence Year is NULL*/
SELECT Name FROM world.country
	WHERE IndepYear = NULL;

/*List Names of all cities in the United Kingdom*/
SELECT ci.Name FROM world.city ci
	INNER JOIN world.country co ON ci.CountryCode = co.Code
		WHERE co.Name = 'United Kingdom';
		
/*List Names of all cities in the State (field name in the table is District) of Texas in the United States of America*/
SELECT Name FROM world.city
	WHERE District = 'Texas' AND CountryCode = 'USA';
    
/*List all fields for countries whose LifeExpectancy is between 50% and 70% (inclusive)*/
SELECT * FROM world.country
	WHERE LifeExpectancy BETWEEN 50.0 AND 70.0;
